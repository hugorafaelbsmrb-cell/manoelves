# ============================================================
# Mano Elves — modelo do .env do Supabase self-hosted
# Copie para o diretório supabase/docker/ como ".env" e preencha.
# Baseado no .env.example oficial; aqui só os campos obrigatórios.
# ============================================================

# Senha do banco Postgres — gere com: openssl rand -hex 16
POSTGRES_PASSWORD=

# Segredo dos JWTs — gere com: openssl rand -hex 32
# Use o MESMO valor para gerar as chaves abaixo com
# deploy/generate-jwt-keys.mjs
JWT_SECRET=

# Chaves geradas a partir do JWT_SECRET acima (passo 4 do README
# do pacote vps-migration)
ANON_KEY=
SERVICE_ROLE_KEY=

# URL pública do gateway (Kong)
# Sem domínio:  http://IP_DA_VPS:8000
# Com domínio:  https://supabase.seudominio.com (via Caddy/HTTPS)
API_EXTERNAL_URL=http://IP_DA_VPS:8000

# URL do site, usada nos redirects de autenticação
# Sem domínio:  http://IP_DA_VPS
SITE_URL=http://IP_DA_VPS

# Login do painel Studio (acessível em http://IP_DA_VPS:3100)
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Porta do Studio — 3100 para não conflitar com o app (3001)
STUDIO_PORT=3100
