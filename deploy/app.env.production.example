# ============================================================
# Mano Elves — variáveis de produção do APP
# Use este arquivo como ".env" na pasta do app na VPS
# (/opt/manoelves). Substitua os marcadores pelos valores reais.
# ============================================================

# URL pública do Supabase self-hosted (gateway Kong)
# Sem domínio: http://IP_DA_VPS:8000
SUPABASE_URL=http://IP_DA_VPS:8000
VITE_SUPABASE_URL=http://IP_DA_VPS:8000

# Chave anon gerada com o JWT_SECRET do Supabase
# (deploy/generate-jwt-keys.mjs) — é pública, pode ficar no build
SUPABASE_PUBLISHABLE_KEY=COLE_AQUI_A_ANON_KEY
VITE_SUPABASE_PUBLISHABLE_KEY=COLE_AQUI_A_ANON_KEY

# Chave service_role — usada SOMENTE no servidor do app (nunca no
# navegador). Se vazar, troque o JWT_SECRET e regenere tudo.
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_A_SERVICE_ROLE_KEY

# Identificador do projeto (qualquer nome no self-hosted)
SUPABASE_PROJECT_ID=manoelves-vps
VITE_SUPABASE_PROJECT_ID=manoelves-vps

# Porta do app — o Caddy faz proxy da porta 80 para cá
PORT=3001
